<Window x:Class="SaddleRAG.Tray.ComponentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:SaddleRAG.Tray.Services;assembly=SaddleRAG.Tray.Core"
        Title="SaddleRAG — components"
        Width="900"
        SizeToContent="Height"
        MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static svc:ComponentState.Running}">
                    <Setter Property="Foreground" Value="ForestGreen"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static svc:ComponentState.Stopped}">
                    <Setter Property="Foreground" Value="Firebrick"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static svc:ComponentState.NotInstalled}">
                    <Setter Property="Foreground" Value="Firebrick"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static svc:ComponentState.Unreachable}">
                    <Setter Property="Foreground" Value="DarkOrange"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static svc:ComponentState.Unknown}">
                    <Setter Property="Foreground" Value="Gray"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <!-- Column widths are fixed (the detail column takes the rest), so the headings line up with every row. -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="246"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Component" Style="{StaticResource ColumnHeader}"/>
            <TextBlock Grid.Column="1" Text="State" Style="{StaticResource ColumnHeader}"/>
            <TextBlock Grid.Column="2" Text="Runs on" Style="{StaticResource ColumnHeader}"/>
            <TextBlock Grid.Column="3" Text="Detail" Style="{StaticResource ColumnHeader}"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="246"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" Style="{StaticResource StateText}"/>
                        <TextBlock Grid.Column="2" Text="{Binding LocationText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Detail}"
                                   ToolTip="{Binding Detail}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Start"   Command="{Binding StartCommand}"   Style="{StaticResource RowButton}"/>
                            <Button Content="Stop"    Command="{Binding StopCommand}"    Style="{StaticResource RowButton}"/>
                            <Button Content="Restart" Command="{Binding RestartCommand}" Style="{StaticResource RowButton}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Separator Margin="0,12"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Restart all"
                    Command="{Binding RestartAllCommand}"
                    Width="110"
                    VerticalAlignment="Top"
                    ToolTip="Restarts Docling, then Ollama, then MongoDB and the SaddleRAG service together. Stops at the first problem."/>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" MinHeight="18"/>
                <TextBlock Text="{Binding LastCheckedText}" Opacity="0.65" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
