<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <SaddleRagBundledRuntimeVersion>10.0.13</SaddleRagBundledRuntimeVersion>
  </PropertyGroup>

  <!-- Shared files must be identical when the server, CLI and tray are combined.
       Pin transitive Microsoft packages too; floating versions can otherwise make
       a later publish overwrite an assembly required by an earlier application. -->
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.7.0" />
    <PackageVersion Include="CodeStructure.Analyzers" Version="1.0.7" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Http.Connections.Client" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client.Core" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.EventSource" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="10.0.13" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.28.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.15.1" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" Version="0.15.1" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.DirectML" Version="0.14.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageVersion Include="MongoDB.Driver" Version="3.12.0" />
    <PackageVersion Include="MudBlazor" Version="9.11.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="OllamaSharp" Version="5.5.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageVersion Include="SharpCompress" Version="0.50.3" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.13" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>

